[Unit]
Description=Collateral Provider API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=collateral-provider
Group=collateral-provider
WorkingDirectory=/srv/collateral-provider/current/collateral_provider
# Fallbacks for the two settings whose defaults are unwritable under the
# sandboxing below. Declared before EnvironmentFile so an explicit value in the
# operator's environment file still overrides them.
#
# CACHE_DIR otherwise defaults inside the release tree, which ProtectSystem=strict
# mounts read-only, and every collateral request 500s. LOG_TO_CONSOLE otherwise
# defaults to False, and merely declaring a RotatingFileHandler makes dictConfig
# open LOG_FILE (also inside the release tree) at startup — that raises during
# settings import and every gunicorn worker dies before binding.
Environment=CACHE_DIR=/var/cache/collateral-provider
Environment=LOG_TO_CONSOLE=True
EnvironmentFile=/etc/collateral-provider/environment
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/collateral-provider/current/.venv/bin/gunicorn collateral_provider.wsgi:application --bind 127.0.0.1:8000 --worker-class gthread --workers 2 --threads 8 --timeout 60 --graceful-timeout 30 --keep-alive 75 --worker-tmp-dir /run/collateral-provider --access-logfile - --error-logfile -
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=60
TimeoutStopSec=35
Restart=on-failure
RestartSec=5
RuntimeDirectory=collateral-provider
RuntimeDirectoryMode=0750
StateDirectory=collateral-provider
StateDirectoryMode=0750
# systemd creates and owns /var/cache/collateral-provider, which is what makes
# the CACHE_DIR fallback above land somewhere writable.
CacheDirectory=collateral-provider
CacheDirectoryMode=0750
UMask=0027

# The process needs outbound DNS/TCP to reach Koios, read-only access to the
# current release and key files, and write access only to its state/runtime
# directories.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=/srv/collateral-provider /etc/collateral-provider
ReadWritePaths=/var/lib/collateral-provider /run/collateral-provider
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
