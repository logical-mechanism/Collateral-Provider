venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local DigitalOcean spec copies contain runtime secrets. The checked-in
# .do/app.yaml remains a placeholder-only template.
.do/app.local.yaml

# Whitenoise writes compressed copies beside each collected static file on
# every collectstatic run. The sources are tracked; these are build output,
# and the deploy and Dockerfile both regenerate them.
collateral_provider/staticfiles/**/*.br
collateral_provider/staticfiles/**/*.gz
